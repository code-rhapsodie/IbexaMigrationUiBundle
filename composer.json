{
    "name": "code-rhapsodie/ibexa-migration-ui-bundle",
    "description": "Ibexa admin UI to browse the status of Doctrine Migrations, Kaliop migrations and Ibexa Doctrine Migrations",
    "type": "symfony-bundle",
    "keywords": [
        "ibexa",
        "migration",
        "admin",
        "doctrine-migrations",
        "kaliop"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Code Rhapsodie",
            "homepage": "https://www.code-rhapsodie.fr/"
        }
    ],
    "require": {
        "php": "^8.1",
        "doctrine/dbal": "^2.13 || ^3.0 || ^4.0",
        "ibexa/admin-ui": "^4.6 || ^5.0",
        "pagerfanta/pagerfanta": "^2.7 || ^3.8 || ^4.0",
        "ibexa/core": "^4.6 || ^5.0",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/framework-bundle": "^5.4 || ^6.4 || ^7.0",
        "symfony/translation-contracts": "^2.5 || ^3.0",
        "twig/twig": "^3.10"
    },
    "suggest": {
        "doctrine/doctrine-migrations-bundle": "Lists migrations tracked by Doctrine Migrations",
        "ibexa/doctrine-migrations": "Lists Ibexa service-based Doctrine migrations",
        "tanoconsulting/ibexa-migration-bundle": "Lists Kaliop-style migrations"
    },
    "autoload": {
        "psr-4": {
            "CodeRhapsodie\\IbexaMigrationUiBundle\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "symfony/yaml": "^5.4 || ^6.4 || ^7.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "rector/rector": "^2.9",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-symfony": "^2.1",
        "phpstan/phpstan-phpunit": "^2.1",
        "ekino/phpstan-banned-code": "^3.2"
    },
    "autoload-dev": {
        "psr-4": {
            "CodeRhapsodie\\IbexaMigrationUiBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "rector": "rector process --dry-run",
        "rector-fix": "rector process",
        "qa": [
            "@cs",
            "@phpstan",
            "@rector",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
